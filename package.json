{
  "name": "@flefebvre/nextjs-redis-cache-handler",
  "version": "0.1.0",
  "description": "Redis/Valkey-backed cache handler for Next.js Cache Components ('use cache'), shared by every instance of a multi-instance deployment.",
  "type": "module",
  "license": "MIT",
  "author": "Florian Lefebvre <florian.lefebvre.contact@gmail.com>",
  "homepage": "https://github.com/flolefebvre/nextjs-redis-cache-handler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flolefebvre/nextjs-redis-cache-handler.git"
  },
  "bugs": {
    "url": "https://github.com/flolefebvre/nextjs-redis-cache-handler/issues"
  },
  "keywords": [
    "next",
    "nextjs",
    "cache-handler",
    "use-cache",
    "cache-components",
    "redis",
    "valkey"
  ],
  "sideEffects": [
    "./dist/handler.js",
    "./dist/handler.node.js",
    "./dist/handler.edge.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "edge-light": "./dist/index.edge.js",
      "default": "./dist/index.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "edge-light": "./dist/handler.edge.js",
      "default": "./dist/handler.js"
    },
    "./handler-target": {
      "types": "./dist/handler.node.d.ts",
      "edge-light": "./dist/handler.edge.js",
      "default": "./dist/handler.node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0",
    "duplication": "jscpd",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "pack:check": "tsx scripts/pack-check.ts",
    "typecheck:dist": "tsc -p tests/dist-consumer/tsconfig.json",
    "smoke:dist": "tsx scripts/smoke-dist.ts",
    "gate": "tsx scripts/gate.ts format:check,lint,duplication,typecheck,test,build,pack:check,typecheck:dist,smoke:dist,test:e2e",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "redis": "^6.2.1"
  },
  "peerDependencies": {
    "next": ">=16.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^10.9.0",
    "eslint-plugin-no-comments": "^1.2.1",
    "jscpd": "^4.3.0",
    "next": "16.3.4",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
